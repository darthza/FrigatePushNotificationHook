# Copy this file to .env and adjust it for your host.

# Keep this true until you have watched the logs and trust the filters.
LISTENER_DRY_RUN=true

# Minimum seconds between notifications for the same camera.
# 300 means a camera can send at most one matching push every 5 minutes.
LISTENER_COOLDOWN_SECONDS=300

# Minimum Frigate object score required before sending a notification.
# Frigate scores are 0.0 to 1.0, so 0.8 means 80%.
LISTENER_MINIMUM_SCORE=0.8

# Container user that should be able to write ./state.
# On most Linux hosts, 1000:1000 is the first non-root user.
LISTENER_UID_GID=1000:1000

# VAPID subject used for web push. Use a contact address you control.
PUSH_SUBJECT=mailto:admin@example.com

# MQTT broker reachable by the listener.
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Host directory containing Frigate's config database and notification key.
# It must contain frigate.db, notifications.pem, and ideally the WAL files
# frigate.db-wal and frigate.db-shm when Frigate is running.
FRIGATE_CONFIG_DIR=/opt/frigate/config
